# Backend application settings
ENV=development
DATABASE_URL=postgresql+asyncpg://facttrack:facttrack@127.0.0.1:5432/facttrack
JWT_SECRET=change-me-in-production-32chars-minimum
JWT_REFRESH_SECRET=change-me-too-refresh-secret-32chars

# Content-addressed storage
CAS_BACKEND=local
CAS_LOCAL_DIR=./cas_store
CAS_S3_BUCKET=
CAS_S3_PREFIX=cas/

# CORS must be JSON so pydantic-settings can parse the list
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional LLM integration for matrix extraction
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash
