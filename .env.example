# ─── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=facttrack
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=facttrack

# ─── Application database URL (used by API and worker) ─────────────────────────
DATABASE_URL=postgresql+asyncpg://facttrack:change_me_in_production@postgres:5432/facttrack

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=replace_with_a_long_random_secret_key_at_least_64_hex_chars

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CAS (Content-Addressed Storage) ──────────────────────────────────────────
CAS_ROOT=/data/cas

# ─── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins; use * for development only
CORS_ORIGINS=http://localhost,http://localhost:80
